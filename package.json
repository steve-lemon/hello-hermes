{
  "name": "hello-hermes",
  "version": "0.1.0",
  "description": "Hermes operating loop tool project built with TypeScript, CLI, MCP, and a Hermes skill.",
  "type": "module",
  "bin": {
    "hello-hermes": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "TOOL_SPEC.md",
    "AGENTS.md",
    "skills",
    "hermes"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/mcp/server.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "hermes",
    "mcp",
    "typescript",
    "npx"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.3"
  }
}
